# Copy to .env. Default setup is 100% LOCAL via Ollama — no API keys needed.

# ---- Local LLM via Ollama (recommended; no API key) ------------------------
# Set OLLAMA_MODEL to use local chat generation. Comment it out to run offline
# (retrieval + graph still work; synthesis returns a structured summary).
OLLAMA_MODEL=nemotron-3-nano:4b
OLLAMA_HOST=http://localhost:11434
# OLLAMA_TIMEOUT=300          # raise if the model is slow on CPU
# OKF_MAX_CONTEXT=3           # max concepts' full text sent to the LLM (citations show all).
#                             # 3 ≈ ~1 min on CPU; raise for richer answers if you have a GPU.

# Embeddings: "ollama" = nomic-embed-text via Ollama (local, no download beyond the model)
#             "hash"   = offline lexical embedder (no server needed; lower quality)
#             "default"= Chroma's bundled all-MiniLM (downloads ~80 MB on first use)
OKF_EMBEDDING=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- Optional frontier providers (only if you prefer them over local) ------
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---- Optional paths --------------------------------------------------------
# CHROMA_PATH=.chroma            # persist the vector index between runs
# OKF_BUNDLE_PATH=okf_bundle     # path to the OKF bundle
